<mujoco model="genkiarm">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" />
  <compiler meshdir="meshes" angle="degree" />
  <default>
    <geom type="mesh" />
  </default>
  <asset>
    <mesh name="link1" file="link1.stl" />
    <mesh name="link2" file="link2.stl" />
    <mesh name="link3" file="link3.stl" />
    <mesh name="link4" file="link4.stl" />
    <mesh name="link5" file="link5.stl" />
    <mesh name="link6" file="link6.stl" />
    <mesh name="link7" file="link7.stl" />
    <mesh name="camera_bracket" file="camera_bracket.stl" scale="0.001 0.001 0.001" />
    <mesh name="ov2735_camera" file="ov2735_camera.stl" scale="0.001 0.001 0.001" />
    <mesh name="usb_c_plug" file="usb_c_plug.stl" scale="0.001 0.001 0.001" />
  </asset>
  <contact>
    <exclude body1="base" body2="shoulder" />
    <exclude body1="shoulder" body2="upper_arm" />
    <exclude body1="upper_arm" body2="forearm" />
    <exclude body1="forearm" body2="wrist" />
    <exclude body1="wrist" body2="gripper" />
    <exclude body1="gripper" body2="finger" />
    <exclude body1="gripper" body2="camera_bracket" />
    <exclude body1="camera_bracket" body2="ov2735_camera" />
  </contact>
  <actuator>
    <pid name="servo1" joint="shoulder_pan" input="pos" kp="5" ki="0.2" kv="0.2" imax="1"
      ctrllimited="true" ctrlrange="-1.570796 1.570796" slewmax="4.98" />
    <pid name="servo2" joint="shoulder_lift" input="pos" kp="30" ki="60" kv="3" imax="1"
      ctrllimited="true" ctrlrange="-1.570796 1.570796" slewmax="0.8" />
    <pid name="servo3" joint="elbow_flex" input="pos" kp="20" ki="40" kv="1.5" imax="1"
      ctrllimited="true" ctrlrange="-1.570796 1.570796" slewmax="4.98" />
    <pid name="servo4" joint="wrist_flex" input="pos" kp="10" ki="20" kv="0.6" imax="1"
      ctrllimited="true" ctrlrange="-1.570796 1.570796" slewmax="4.98" />
    <pid name="servo5" joint="wrist_roll" input="pos" kp="5" ki="0.2" kv="0.2" imax="1"
      ctrllimited="true" ctrlrange="-1.570796 1.570796" slewmax="4.98" />
    <pid name="servo6" joint="gripper" input="pos" kp="5" ki="0.2" kv="0.2" imax="1"
      ctrllimited="true" ctrlrange="0 1.570796" />
  </actuator>
  <visual>
    <!-- <global cameraid="0" offwidth="1920" offheight="1080" /> -->
  </visual>
  <worldbody>
    <light pos="0 0 3" />
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1.0" />

    <body name="base" pos="0 0 0">
      <geom mesh="link1" />
      <body name="shoulder" pos="-0.0125 0 0.02648552" euler="0 -90 0">
        <geom mesh="link2" />
        <joint name="shoulder_pan" type="hinge" axis="-1 0 0" damping="0.01" />
        <body name="upper_arm" pos="0.08168 0 0" euler="0 90 0">
          <geom mesh="link3" />
          <joint name="shoulder_lift" type="hinge" axis="0 -1 0" damping="0.01" />
          <body name="forearm" pos="-0.00005031 0 0.11690062" euler="0 -90 0">
            <geom mesh="link4" />
            <joint name="elbow_flex" type="hinge" axis="0 -1 0" damping="0.01" />
            <body name="wrist" pos="-0.00005031 0 0.11690062" euler="0 0 0">
              <geom mesh="link5" />
              <joint name="wrist_flex" type="hinge" axis="0 -1 0" damping="0.01" />
              <body name="gripper" pos="0.00017464 -0.00005032 0.06419579" euler="0 0 0">
                <geom mesh="link6" />
                <site name="tcp" pos="0 0.00755 0.102" size="0.004" rgba="1 0.2 0.1 1" />
                <joint name="wrist_roll" type="hinge" axis="0 0 -1" damping="0.01" />
                <body name="finger" pos="0 -0.0125 0.0209133" euler="0 0 0">
                  <geom mesh="link7" />
                  <joint name="gripper" type="hinge" axis="1 0 0" damping="0.01" />
                </body>
                <body name="camera_bracket" pos="-0.000207365 0.037632515 0.004579254">
                  <geom mesh="camera_bracket" />
                  <body name="ov2735_camera" pos="0.050801742604 -0.037664879368 0.016230274542"
                    euler="0 -25 -90">
                    <geom mesh="ov2735_camera" />
                    <geom name="usb_c_plug" mesh="usb_c_plug" mass="0" contype="0" conaffinity="0"
                      rgba="0.12 0.15 0.18 1" />
                    <camera name="OV2735" pos="0 0 0.0177" xyaxes="-1 0 0 0 1 0" mode="fixed"
                      projection="perspective" resolution="1920 1080" output="rgb" fovy="57.135724" />
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
